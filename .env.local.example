# GDG SKNCOE Next.js Environment Variables
# Copy this file to .env.local and modify as needed

# Page Loader Configuration
# Timeout in milliseconds (minimum: 500, maximum: 10000)
# Default: 2000 (2 seconds)
NEXT_PUBLIC_PAGE_LOADER_TIMEOUT=2000

# API Configuration
# Backend API URL (for future API integrations)
NEXT_PUBLIC_API_URL=http://localhost:5501

# Social Media Links (for future dynamic configuration)
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/gdgskncoe
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/gdgskncoe
NEXT_PUBLIC_GITHUB_URL=https://github.com/gdgskncoe

# Contact Email
NEXT_PUBLIC_CONTACT_EMAIL=contact@gdgskncoe.com

